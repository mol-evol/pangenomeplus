# PanGenomePlus Slash Commands
# Custom commands for common development operations

# Development and Testing Commands
/test: source venv/bin/activate && pytest -v
/coverage: source venv/bin/activate && pytest --cov=pangenomeplus --cov-report=html --cov-report=term
/lint: source venv/bin/activate && black --check . && isort --check . && flake8 . && mypy pangenomeplus/
/format: source venv/bin/activate && black . && isort .
/quality: source venv/bin/activate && pre-commit run --all-files

# Pipeline Testing Commands
/test-feature: source venv/bin/activate && pytest tests/test_feature.py -v
/test-compact: source venv/bin/activate && pytest tests/test_compact_ids.py -v
/test-extraction: source venv/bin/activate && pytest tests/test_extraction.py -v
/test-clustering: source venv/bin/activate && pytest tests/test_clustering.py -v

# Installation and Setup
/setup-dev: source venv/bin/activate && pip install -e .
/setup-hooks: source venv/bin/activate && pre-commit install && pre-commit run --all-files

# PanGenomePlus Pipeline Commands (when implemented)
/run-test-data: source venv/bin/activate && pangenomeplus --input test_data/8_ecoli/ --output test_output/ --threads 4
/run-medium-data: source venv/bin/activate && pangenomeplus --input large_ecoli_analysis/ --output medium_output/ --threads 8
/validate-results: source venv/bin/activate && python scripts/validate_output.py

# Documentation and Analysis
/docs: source venv/bin/activate && sphinx-build -b html docs/ docs/_build/
/benchmark: source venv/bin/activate && python scripts/benchmark.py
/profile: source venv/bin/activate && python -m cProfile -o profile_output.prof scripts/profile_pipeline.py

# Cleanup Commands
/clean: rm -rf htmlcov/ .coverage .mypy_cache/ .pytest_cache/ __pycache__/ */.__pycache__/ */*.pyc
/clean-all: rm -rf htmlcov/ .coverage .mypy_cache/ .pytest_cache/ __pycache__/ */.__pycache__/ */*.pyc venv/ dist/ build/ *.egg-info/
